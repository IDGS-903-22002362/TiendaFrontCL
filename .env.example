# ==============================
# Storefront API (required)
# ==============================
# Nota: usa una base terminada en /api. Los paths del backend tambien
# empiezan con /api, por lo que la URL final esperada es /api/api/...

# Local backend base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Optional server-side fallback base URL (Route Handlers / Server Actions).
# Debe terminar en /api igual que NEXT_PUBLIC_API_BASE_URL.
API_BASE_URL=http://localhost:3000/api

# Frontend IP allowlist. Empty disables the restriction.
# Example: ALLOWED_FRONT_IPS=203.0.113.10,198.51.100.25
ALLOWED_FRONT_IPS=

# ==============================
# Firebase Web SDK (required for login)
# ==============================
# Opción recomendada: usar proyecto Firebase exclusivo para Auth
NEXT_PUBLIC_AUTH_FIREBASE_API_KEY=
NEXT_PUBLIC_AUTH_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_AUTH_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_AUTH_FIREBASE_APP_ID=
NEXT_PUBLIC_AUTH_FIREBASE_STORAGE_BUCKET=

# Compatibilidad (legacy)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ==============================
# Analítica / marketing (opcional, condicionados a consentimiento)
# ==============================
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_GOOGLE_ADS_ID=
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# NEXT_PUBLIC_HOTJAR_ID=
# NEXT_PUBLIC_CLARITY_ID=

