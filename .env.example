# NEXT_PUBLIC_AUTH_FIREBASE_APP_ID=1:172494578172:web:03be52b69d196b1a071279
# NEXT_PUBLIC_AUTH_FIREBASE_STORAGE_BUCKET=e-comerce-leon.firebasestorage.app
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ==============================
# Sentry (opcional)
# ==============================
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
